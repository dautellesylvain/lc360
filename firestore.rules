rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.uid == 'c3wT2I44DyRd6pb59hQ3c6QhOdR2'; }
    function projectOwner(projectId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // ── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read:   if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['plan', 'role', 'stripeCustomerId', 'stripeSubStatus', 'sketchupKey']);
    }

    // ── Projects ──────────────────────────────────────────────
    match /projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if signedIn()
        && resource != null
        && resource.data.ownerId == request.auth.uid;

      allow read: if signedIn()
        && resource != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow read: if resource != null
        && resource.data.shareEnabled == true
        && resource.data.published == true;
    }

    // ── Config ────────────────────────────────────────────────
    match /config/{document} {
      allow read:  if true; // Lecture publique pour le backend
      allow write: if isAdmin();
    }
    match /analytics/{projectId} {
      allow read, write: if projectOwner(projectId) || isAdmin();
    }

    match /analytics/{projectId}/visits/{visitId} {
      allow create, update: if true;
      allow read, delete:   if projectOwner(projectId) || isAdmin();
    }
  }
}
